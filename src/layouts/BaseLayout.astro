---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { site } from "../data/site";
import { toMetadataText } from "../utils/math";

interface Props {
  title?: string;
  description?: string;
  lang?: "en" | "zh-CN";
}

const { title, description = site.metaDescription, lang = "en" } = Astro.props;
const pageTitle = toMetadataText(title ? `${title} | ${site.name}` : site.name);
const pageDescription = toMetadataText(description);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/images/social/laboratory.png", Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={lang === "zh-CN" ? "zh_CN" : "en_US"} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Laboratory of Quantum Integrability — integrable systems and mathematical physics." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Laboratory of Quantum Integrability — integrable systems and mathematical physics." />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === "zh-CN" ? "跳到正文" : "Skip to content"}</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
