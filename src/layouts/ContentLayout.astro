---
import BaseLayout from "./BaseLayout.astro";
import InlineMathText from "../components/InlineMathText.astro";

interface Props {
  title: string;
  description?: string;
  metaDescription?: string;
  eyebrow?: string;
  lang?: "en" | "zh-CN";
}

const { title, description, metaDescription = description, eyebrow, lang } = Astro.props;
---

<BaseLayout title={title} description={metaDescription} lang={lang}>
  <article class="container page reading-page">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="page-title"><InlineMathText text={title} /></h1>
    {description && <p class="lead"><InlineMathText text={description} /></p>}
    <div class="prose section">
      <slot />
    </div>
  </article>
</BaseLayout>
<style>
  .reading-page {
    width: min(var(--width-detail), calc(100% - 40px));
  }

  .page-title { text-wrap: balance; }

  .reading-page :global(.math) {
    display: inline-block;
    font-family: var(--font-editorial);
    font-style: italic;
    letter-spacing: -0.04em;
  }

  .reading-page :global(.math-overline) {
    text-decoration: overline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.08em;
  }
</style>
