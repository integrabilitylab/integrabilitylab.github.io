---
import BaseLayout from "./BaseLayout.astro";
import InlineMathText from "../components/InlineMathText.astro";

interface Props {
  title: string;
  description?: string;
  metaDescription?: string;
  eyebrow?: string;
  lang?: "en" | "zh-CN";
  image?: string;
  imageAlt?: string;
  /** Use the full detail width instead of the centered reading column. */
  wide?: boolean;
}

const {
  title,
  description,
  metaDescription = description,
  eyebrow,
  lang,
  image,
  imageAlt = "",
  wide = false,
} = Astro.props;
---

<BaseLayout title={title} description={metaDescription} lang={lang}>
  <article class:list={["container", "page", "reading-page", { wide }]}>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="page-title"><InlineMathText text={title} /></h1>
    {description && <p class="lead"><InlineMathText text={description} /></p>}
    <slot name="meta" />
    <div class="prose section">
      {image && <img class="content-image" src={image} alt={imageAlt} />}
      <slot />
    </div>
  </article>
</BaseLayout>
<style>
  /* Article pages read as one centered column: title, lead and prose share
     the same left and right edges, so the page no longer leans left. */
  .reading-page {
    width: min(72ch, calc(100% - 40px));
  }

  .reading-page.wide {
    width: min(var(--width-detail), calc(100% - 40px));
  }

  /* Keep headlines inside the reading column so long titles wrap rather than
     extending into the page gutter as a single overlong line. */
  .reading-page:not(.wide) .page-title {
    max-width: 100%;
    font-size: clamp(2rem, 3.8vw, 2.6rem);
    line-height: 1.2;
  }

  .page-title { text-wrap: balance; }

  .content-image {
    margin-bottom: var(--space-4);
  }

  .reading-page :global(.math) {
    display: inline-block;
    font-family: var(--font-editorial);
    font-style: italic;
    letter-spacing: -0.04em;
  }

  .reading-page :global(.math-overline) {
    text-decoration: overline;
    text-decoration-thickness: 0.08em;
  }
</style>
