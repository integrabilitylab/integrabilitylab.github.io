---
import BaseLayout from "./BaseLayout.astro";
import InlineMathText from "../components/InlineMathText.astro";

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  lang?: "en" | "zh-CN";
}

const { title, description, eyebrow, lang } = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang}>
  <article class="container page reading-page">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="page-title"><InlineMathText text={title} /></h1>
    {description && <p class="lead"><InlineMathText text={description} /></p>}
    <div class="prose section">
      <slot />
    </div>
  </article>
</BaseLayout>
<style is:global>
  .math {
    display: inline-block;
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    letter-spacing: -0.04em;
  }

  .math-overline {
    text-decoration: overline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.08em;
  }
</style>
