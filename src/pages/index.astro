---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentList from "../components/ContentList.astro";
import PublicationItem from "../components/PublicationItem.astro";
import UsefulLinks from "../components/UsefulLinks.astro";
import IntegrabilityArt from "../components/IntegrabilityArt.astro";
import { site } from "../data/site";
const publications = (await getCollection("publications")).sort((a,b) => b.data.year-a.data.year || a.data.order-b.data.order).slice(0,3);
const updates = [...await getCollection("news"), ...await getCollection("events")].sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf()).slice(0,4);
---
<BaseLayout title="Home" description={site.metaDescription}>
  <section class="container hero">
    <div class="hero-copy">
      <p class="eyebrow">QUANTUM PHYSICS · MATHEMATICAL STRUCTURES</p>
      <h1>Laboratory of<br />Quantum <em>Integrability</em></h1>
      {site.description && <p class="lead">{site.description}</p>}
      <div class="hero-links"><a class="text-link" href="/about/">About the laboratory <span aria-hidden="true">→</span></a></div>
    </div>
    <IntegrabilityArt />
  </section>
  <div class="container spin-strip" aria-hidden="true"><span>QUANTUM INTEGRABILITY</span><div class="chain">{Array.from({length:12}, (_,i) => <span>{i%2 ? '↓' : '↑'}</span>)}</div><span>STRUCTURE THROUGH SYMMETRY</span></div>
  <div class="container updates">
    <section><div class="section-heading"><h2><span>01</span> News & Events</h2><a href="/news/">All news & events ↗</a></div><ContentList items={updates} headingLevel="h3" /></section>
    <section><div class="section-heading"><h2><span>02</span> Publications</h2><a href="/publications/">All publications ↗</a></div><div class="stack">{publications.map(publication => <PublicationItem publication={publication} headingLevel="h3" />)}</div></section>
  </div>
  <section class="container links-section"><div class="section-heading"><h2><span>03</span> Useful Links</h2></div><UsefulLinks /></section>
</BaseLayout>
<style>
  .hero { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,1fr); gap:var(--space-5); align-items:center; padding-block:var(--space-6) 3.75rem; }
  .hero-copy { min-width:0; }
  h1 { font: normal clamp(2.6rem,4.7vw,4.5rem)/1.08 var(--font-editorial); letter-spacing:-.045em; margin:var(--space-3) 0; }
  h1 em { color:var(--accent); font-weight:normal; }
  .hero .lead { max-width:38ch; margin-bottom:var(--space-4); color:var(--accent-strong); font:italic 1.3rem/1.5 var(--font-editorial); letter-spacing:-.01em; }
  .hero-links { display:flex; flex-wrap:wrap; gap:24px; align-items:center; font-size:13px; }
  .text-link { border-bottom:1px solid var(--border); padding-block:8px; }
  .spin-strip { display:flex; align-items:center; justify-content:space-between; gap:24px; border-block:1px solid var(--border); padding-block:22px; font:10px/1.5 ui-monospace,monospace; letter-spacing:.1em; color:var(--muted); }
  .chain { display:flex; align-items:center; flex:1; max-width:340px; justify-content:space-between; position:relative; }
  .chain:before { content:''; position:absolute; height:1px; background:var(--border); width:100%; }
  .chain span { position:relative; border:1px solid #9bab9e; border-radius:50%; width:19px; height:19px; background:var(--background); text-align:center; color:var(--accent); font-size:12px; }
  .updates { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-5); padding-block:var(--space-5); }
  .section-heading { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:22px; }
  .section-heading h2 { font:normal 1.75rem var(--font-editorial); margin:0; }
  .section-heading h2 span { font:11px ui-monospace,monospace; color:var(--muted); margin-right:14px; }
  .section-heading > a { font-size:.75rem; flex-shrink:0; }
  .links-section { padding-bottom:var(--space-6); }
  @media(max-width:900px) {
    .hero { grid-template-columns:minmax(0,1fr); gap:var(--space-4); padding-block:var(--space-5); }
    .hero :global(.integrability-art) { width:100%; max-width:560px; justify-self:center; }
    .updates { grid-template-columns:minmax(0,1fr); gap:var(--space-4); }
    .spin-strip > span:last-child { display:none; }
  }
  @media(max-width:600px) {
    .hero { padding-block:var(--space-4) var(--space-3); gap:var(--space-3); }
    .hero .eyebrow { margin-top:0; font-size:.6rem; letter-spacing:.1em; }
    h1 { font-size:clamp(2.1rem,7vw,2.7rem); margin-block:var(--space-2); }
    .hero .lead { font-size:1.1rem; margin-bottom:var(--space-1); }
    .spin-strip { display:none; }
    .updates { padding-block:var(--space-3); }
    .section-heading { flex-wrap:wrap; gap:var(--space-1) var(--space-2); margin-bottom:var(--space-2); }
    .section-heading h2 { font-size:1.5rem; }
    .links-section { padding-bottom:var(--space-5); }
  }
</style>
