---
import { localizedCollection } from "../../utils/localizedContent";
import { localeFromPath, translated } from "../../utils/i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonCard from "../../components/PersonCard.astro";

const locale = localeFromPath(Astro.url.pathname);
const people = (await localizedCollection("people", locale)).sort(
  (a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name),
);
const groups = [
  { id: "faculty", title: translated(locale, "Faculty", "教师") },
  { id: "postdocs", title: translated(locale, "Postdocs", "博士后") },
  { id: "students", title: translated(locale, "Students", "学生") },
  { id: "alumni", title: translated(locale, "Alumni", "往届成员") },
] as const;
---

<BaseLayout title={translated(locale, "People", "成员")} description={translated(locale, "Meet the faculty, postdocs, students and alumni of the Laboratory of Quantum Integrability at Southeast University. Read member profiles and research interests.", "了解东南大学量子可积实验室的教师、博士后、学生及往届成员，浏览成员简介与研究方向。")}>
  <section class="container page">
    <p class="eyebrow">{translated(locale, "Members", "实验室成员")}</p>
    <h1 class="page-title">{translated(locale, "People", "成员")}</h1>
    <p class="lead">{translated(locale, "Faculty, postdocs, students, and alumni of the lab.", "汇聚教师、博士后、学生与往届成员。")}</p>
    <nav class="people-nav" aria-label={translated(locale, "People categories", "成员分类")}>
      {groups.map(group => <a href={`#${group.id}`}>{group.title}<span aria-hidden="true">↗</span></a>)}
    </nav>
    {groups.map((group, index) => {
      const members = people.filter(person => person.data.category === group.id);
      return (
        <section class="people-group" id={group.id} aria-labelledby={`${group.id}-title`}>
          <h2 id={`${group.id}-title`} class="group-title"><span aria-hidden="true">0{index + 1}</span>{group.title}</h2>
          {members.length > 0 ? (
            <div class="grid two">{members.map(person => <PersonCard person={person} />)}</div>
          ) : (
            <p class="empty-group">{translated(locale, "Member profiles will be added soon.", "成员信息将陆续更新。")}</p>
          )}
        </section>
      );
    })}
  </section>
</BaseLayout>

<style>
  .people-nav { display:flex; flex-wrap:wrap; gap:12px 32px; border-bottom:1px solid var(--border); padding-block:16px 24px; margin-top:24px; }
  .people-nav a { display:flex; gap:24px; align-items:center; font-size:.9rem; }
  .people-nav span { color:var(--muted); }
  .people-group { margin-top:44px; scroll-margin-top:24px; }
  .people-group .grid.two { column-gap: 2.25rem; }
  .group-title { display:flex; gap:18px; align-items:baseline; margin:0 0 22px; font:normal 30px/1.2 var(--font-editorial); }
  .group-title span { color:var(--muted); font:11px ui-monospace,monospace; }
  .empty-group { margin:0; padding:4px 0 16px; color:var(--muted); font-size:.95rem; }
</style>
