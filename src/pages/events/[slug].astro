---
import { formatDate } from "../../utils/date";
import { getCollection, render } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const date = formatDate(event.data.date, "long");
---

<ContentLayout
  title={event.data.title}
  description={event.data.summary}
  eyebrow={date}
  lang={event.data.language}
  image={event.data.image}
  imageAlt={event.data.image ? `${event.data.title} poster` : undefined}
>
  {event.data.location && <p slot="meta" class="meta event-location">Location: {event.data.location}</p>}
  <Content />
</ContentLayout>

<style>
  .event-location {
    margin: 0.75rem 0 0;
  }
</style>
