---
import { localeFromPath, localizedPath, localizedSite, translated } from "../utils/i18n";
import { formatYear } from "../utils/date";
const locale = localeFromPath(Astro.url.pathname);
const site = localizedSite(locale);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>&copy; {formatYear()} {site.name}</p>
    <nav aria-label={translated(locale, "Footer navigation", "页脚导航")}>
      {site.footer.map((item) => <a href={localizedPath(item.href, locale)}>{item.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 28px;
  }

  p {
    margin: 0;
  }

  nav {
    display: flex;
    gap: 14px;
  }

  @media (max-width: 640px) {
    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
