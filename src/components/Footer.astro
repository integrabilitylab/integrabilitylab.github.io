---
import { site } from "../data/site";
import { formatYear } from "../utils/date";
import LabMark from "./LabMark.astro";
---

<footer class="site-footer">
  <div class="container footer-main">
    <a class="footer-brand" href="/">
      <span class="footer-mark"><LabMark /></span>
      <span class="footer-brand-copy">
        <strong>{site.name}</strong>
        <span>Southeast University · Nanjing, China</span>
      </span>
    </a>
    <nav aria-label="Footer navigation">
      {site.footer.map((item) => <a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a>)}
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {formatYear()} {site.name}</p>
    <p>Integrable systems · Mathematical physics</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgb(255 255 255 / 8%);
    background: var(--accent-strong);
    color: #dce7df;
  }

  .footer-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: 36px 30px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: #f8f6ee;
  }

  .footer-brand:hover { text-decoration: none; }
  .footer-mark { flex: 0 0 46px; width: 46px; height: 46px; color: #dce7df; }
  .footer-brand-copy { display: grid; gap: 6px; }
  .footer-brand-copy strong { font: 1.05rem/1.35 var(--font-editorial); letter-spacing: .005em; }
  .footer-brand-copy > span { color: #b9cbc1; font-size: .72rem; letter-spacing: .035em; }

  nav { display: flex; flex-wrap: wrap; gap: 12px; }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 9px 14px;
    border: 1px solid rgb(220 231 223 / 30%);
    border-radius: 999px;
    color: #f8f6ee;
    font-size: .8rem;
    transition: background-color .18s ease, border-color .18s ease;
  }
  nav a:hover { border-color: rgb(220 231 223 / 60%); background: rgb(255 255 255 / 8%); text-decoration: none; }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 18px 24px;
    border-top: 1px solid rgb(220 231 223 / 16%);
    color: #b9cbc1;
    font-size: .7rem;
  }

  p { margin: 0; }

  @media (max-width: 640px) {
    .footer-main, .footer-bottom { align-items: flex-start; flex-direction: column; }
    .footer-main { gap: var(--space-3); padding-block: 30px 24px; }
    .footer-brand { align-items: flex-start; }
    .footer-brand-copy strong { max-width: 24ch; }
    .footer-bottom { gap: 6px; padding-block: 16px 22px; }
  }

  @media (prefers-reduced-motion: reduce) {
    nav a { transition: none; }
  }
</style>
