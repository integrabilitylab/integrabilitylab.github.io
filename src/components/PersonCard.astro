---
import InlineMathText from "./InlineMathText.astro";
interface Props {
  person: {
    id: string;
    data: {
      name: string;
      role: string;
      avatar?: string;
      interests?: string[];
    };
  };
}

const { person } = Astro.props;
---

<article class="person-card">
  {
    person.data.avatar && (
      <img src={person.data.avatar} alt={`${person.data.name} portrait`} width="120" height="180" />
    )
  }
  <div>
    <h2><a href={`/people/${person.id}/`}>{person.data.name}</a></h2>
    <p class="meta">{person.data.role}</p>
    {
      person.data.interests && person.data.interests.length > 0 && (
        <ul>
          {person.data.interests.map((interest) => <li><InlineMathText text={interest} /></li>)}
        </ul>
      )
    }
  </div>
</article>

<style>
  .person-card {
    display: flex;
    gap: 28px;
    align-items: flex-start;
    padding: 24px 0 28px;
    border-top: 1px solid var(--border);
  }

  img {
    width: 120px;
    height: 180px;
    flex: 0 0 auto;
    border-radius: 4px;
    object-fit: cover;
    object-position: top;
  }

  h2 {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.25;
  }

  p {
    margin: 6px 0 0;
  }

  ul {
    margin: 8px 0 0;
    padding-left: 18px;
  }

  li {
    margin: 2px 0;
  }
  @media (max-width: 480px) {
    .person-card { flex-direction: column; gap: 16px; }
  }
</style>
