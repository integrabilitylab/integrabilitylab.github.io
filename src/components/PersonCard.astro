---
import InlineMathText from "./InlineMathText.astro";
interface Props {
  person: {
    id: string;
    data: {
      name: string;
      role: string;
      avatar?: string;
      interests?: string[];
    };
  };
}

const { person } = Astro.props;
---

<article class:list={["person-card", { "no-portrait": !person.data.avatar }]}>
  {
    person.data.avatar && (
      <img src={person.data.avatar} alt={`${person.data.name} portrait`} width="120" height="180" />
    )
  }
  <div class="identity">
    <h3><a href={`/people/${person.id}/`}>{person.data.name}</a></h3>
    <p class="meta">{person.data.role}</p>
  </div>
  {
    person.data.interests && person.data.interests.length > 0 && (
      <ul class="interests">
        {person.data.interests.map((interest) => <li><InlineMathText text={interest} /></li>)}
      </ul>
    )
  }
</article>

<style>
  .person-card {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    gap: var(--space-1) 1.75rem;
    align-items: start;
    padding: var(--space-3) 0 1.75rem;
    border-top: 1px solid var(--border);
  }

  img {
    width: 120px;
    height: 180px;
    grid-row: 1 / span 2;
    border-radius: 4px;
    object-fit: cover;
    object-position: top;
  }

  .identity, .interests { grid-column: 2; min-width: 0; }
  .no-portrait { grid-template-columns: minmax(0, 1fr); }
  .no-portrait :is(.identity, .interests) { grid-column: 1; }

  h3 {
    margin: 0;
    font-size: var(--text-entry);
    line-height: 1.25;
  }

  p {
    margin: 6px 0 0;
  }

  ul {
    margin: 0;
    padding-left: 18px;
  }

  li {
    margin: 2px 0;
  }
  @media (max-width: 480px) {
    .person-card { grid-template-columns: 80px minmax(0, 1fr); gap: var(--space-2); }
    img { width: 80px; height: 108px; grid-row: 1; }
    .identity { align-self: center; }
    .interests { grid-column: 1 / -1; }
    .no-portrait { grid-template-columns: minmax(0, 1fr); }
  }
</style>
