---
import InlineMathText from "./InlineMathText.astro";
import { formatDate } from "../utils/date";
import { collectionPath, localeFromPath, localizedPath } from "../utils/i18n";
interface Props {
  item: {
    id: string;
    collection: string;
    data: {
      language?: "en" | "zh-CN";
      title: string;
      date: Date;
      summary?: string;
      location?: string;
      speaker?: string;
    };
  };
}

const { item } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const href = localizedPath(`/${collectionPath(item.collection)}/${item.id}/`, locale);
const date = formatDate(item.data.date, "short", locale);
---

<article class="content-entry" lang={item.data.language}>
  <p class="meta">{date}{item.data.location ? ` · ${item.data.location}` : ""}</p>
  <h2><a href={href}><InlineMathText text={item.data.title} /></a></h2>
  {item.data.speaker && <p class="meta">{item.data.speaker}</p>}
  {item.data.summary && <p><InlineMathText text={item.data.summary} /></p>}
</article>

<style>
  h2 {
    margin: 4px 0 0;
    font-size: 1.12rem;
    line-height: 1.3;
  }

  p {
    margin: 8px 0 0;
  }
</style>
