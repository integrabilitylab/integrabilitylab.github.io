---
import { formatDate } from "../utils/date";
interface Props {
  headingLevel?: "h2" | "h3";
  items: Array<{
    id: string;
    collection: string;
    data: {
      title: string;
      date?: Date;
      summary?: string;
      location?: string;
    };
  }>;
}

import InlineMathText from "./InlineMathText.astro";
const { items, headingLevel: Heading = "h2" } = Astro.props;
---

<div class="stack">
  {
    items.map((item) => (
      <article class="content-entry">
        {item.data.date && (
          <p class="meta">
            {formatDate(item.data.date, "short")}{item.data.location ? ` · ${item.data.location}` : ""}
          </p>
        )}
        <Heading><a href={`/${item.collection}/${item.id}/`}><InlineMathText text={item.data.title} /></a></Heading>
        {item.data.summary && <p><InlineMathText text={item.data.summary} /></p>}
      </article>
    ))
  }
</div>

<style>
  h2, h3 {
    margin: 4px 0 0;
    font-size: var(--text-entry);
    line-height: 1.3;
  }

  p {
    margin: 8px 0 0;
  }
</style>
