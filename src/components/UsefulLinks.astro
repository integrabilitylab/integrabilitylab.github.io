---
import { usefulLinks } from "../data/usefulLinks";
---
<ul class="useful-links">
  {usefulLinks.map((link) => (
    <li>
      <a href={link.url}>
        <span class="logo"><img src={link.logo} alt="" width="56" height="56" loading="lazy" /></span>
        <span class="link-copy"><span class="name" lang={link.lang}>{link.name}</span><span class="domain">{link.domain}</span></span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ul>
<style>
  .useful-links { list-style:none; margin:0; padding:0; display:grid; gap:16px; grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr)); }
  li { min-width:0; }
  a {
    display:flex;
    align-items:center;
    gap:16px;
    height:100%;
    min-height:116px;
    padding:20px;
    border:1px solid var(--border);
    border-radius:var(--radius-medium);
    background:var(--surface);
    box-shadow:0 1px 2px rgb(20 63 53 / 3%);
    color:var(--text);
    transition:border-color .18s ease, background-color .18s ease, box-shadow .18s ease, transform .18s ease;
  }
  a:hover { border-color:var(--accent-soft); background:var(--surface-hover); box-shadow:var(--shadow-small); text-decoration:none; transform:translateY(-3px); }
  .logo { display:grid; place-items:center; flex:0 0 56px; width:56px; height:56px; padding:5px; border:1px solid var(--tint-border); border-radius:14px; background:var(--tint); }
  img { width:46px; height:46px; object-fit:contain; border-radius:9px; }
  .link-copy { min-width:0; display:grid; gap:6px; }
  .name { font-size:.92rem; font-weight:600; line-height:1.45; overflow-wrap:anywhere; }
  .domain { color:var(--muted); font:10px/1.5 var(--font-mono); overflow-wrap:anywhere; }
  .arrow { margin-left:auto; align-self:flex-start; color:var(--accent); font-size:1.05rem; transition:transform .18s ease; }
  a:hover .arrow { transform:translate(2px,-2px); }
  @media(max-width:600px) { a { min-height:100px; padding:16px; } }
  @media(prefers-reduced-motion:reduce) {
    a, .arrow { transition:none; }
    a:hover, a:hover .arrow { transform:none; }
  }
</style>
